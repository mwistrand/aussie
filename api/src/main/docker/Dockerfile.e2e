# syntax=docker/dockerfile:1.4
#
# Runtime-only Dockerfile used by the e2eTest source set.
#
# Unlike Dockerfile.jvm (which performs the full Gradle build inside the image),
# this expects build/quarkus-app/ to already be assembled on the host. The
# e2eTest Gradle task depends on :quarkusBuild, so the artifact is always
# present when Testcontainers feeds this file to docker build.
#
# Context (from this file): the `api` directory. Build is driven by
# Testcontainers ImageFromDockerfile in api/src/e2eTest/java/aussie/e2e/support/E2EHarness.java.
FROM registry.access.redhat.com/ubi9/openjdk-21:1.23

ENV LANGUAGE='en_US:en'

COPY --chown=185 build/quarkus-app/lib/      /deployments/lib/
COPY --chown=185 build/quarkus-app/*.jar     /deployments/
COPY --chown=185 build/quarkus-app/app/      /deployments/app/
COPY --chown=185 build/quarkus-app/quarkus/  /deployments/quarkus/

EXPOSE 8080
USER 185

ENV GC_CONTAINER_OPTIONS="-XX:+UseZGC -XX:+ZGenerational"
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
