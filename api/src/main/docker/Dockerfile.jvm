# syntax=docker/dockerfile:1.4
####
# Multi-stage Dockerfile for building and running the Quarkus application in JVM mode.
#
# This Dockerfile performs the Gradle build in a builder
# stage and copies the assembled `build/quarkus-app` into a minimal runtime image.
#
# Build with (from repository root):
#   docker build -f api/src/main/docker/Dockerfile.jvm -t quarkus/aussie-jvm ./api
#
# Or let docker-compose (context: ./api) build it for you.
#
# Notes:
# - The builder stage uses the Gradle image and leverages a build cache mount for
#   `/home/gradle/.gradle` to speed up dependency downloads when using BuildKit.
# - Tests are a separate gate because the image build has no live service dependencies.
###

# ---- Builder stage ----
FROM gradle:9-jdk25 AS builder

WORKDIR /workspace

# Copy wrapper and Gradle metadata first to maximize layer cache reuse
COPY gradlew gradlew
COPY gradle gradle
COPY build.gradle settings.gradle gradle.properties ./

RUN chmod +x gradlew

# Copy the rest of the project (context for this Dockerfile is the `api` directory)
COPY . .

# Verify formatting and build without coupling the builder to live services.
RUN --mount=type=cache,target=/home/gradle/.gradle \
    ./gradlew clean spotlessCheck build -x test

# ---- Runtime stage ----
FROM eclipse-temurin:25-jre

ENV LANGUAGE='en_US:en'

# Copy only the assembled application from the builder stage
COPY --chown=185 --from=builder /workspace/build/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 --from=builder /workspace/build/quarkus-app/*.jar /deployments/
COPY --chown=185 --from=builder /workspace/build/quarkus-app/app/ /deployments/app/
COPY --chown=185 --from=builder /workspace/build/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
# Generational ZGC keeps GC pauses sub-millisecond on JDK 25, which a 1ms-budget
# gateway path cannot tolerate from G1. AlwaysPreTouch faults pages at startup
# so the first burst of traffic does not pay page-fault latency. Heap sizing
# (-Xms/-Xmx) and Netty direct-memory tuning are deployment-specific and should
# be set per environment via JAVA_OPTS.
#
# GC_CONTAINER_OPTIONS overrides the base image's default `-XX:+UseParallelGC`
# (plus its MinHeapFreeRatio/MaxHeapFreeRatio/GCTimeRatio/AdaptiveSizePolicyWeight
# companions). Without this override, run-java.sh emits both UseParallelGC and
# UseZGC on the command line and the JVM aborts with "Multiple garbage
# collectors selected".
ENV GC_CONTAINER_OPTIONS="-XX:+UseZGC -XX:+ZGenerational"
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager -XX:+AlwaysPreTouch"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "java", "-jar", "/deployments/quarkus-run.jar" ]
